{
  "name": "taniamelo-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Testes de contrato da API (auth, clientes, agenda). Projeto Node autocontido; não participa do build Maven.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:local": "API_BASE_URL=http://localhost:8080 playwright test",
    "test:aws": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "postman:all": "node scripts/run-all-postman.mjs",
    "postman:aws": "API_BASE_URL=http://98.82.73.175:8080 node scripts/run-all-postman.mjs",
    "postman:local": "API_BASE_URL=http://localhost:8080 node scripts/run-all-postman.mjs",
    "postman:public": "node scripts/run-all-postman.mjs --public-only"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.19.0",
    "newman": "^6.2.2",
    "typescript": "^5.6.0"
  }
}
