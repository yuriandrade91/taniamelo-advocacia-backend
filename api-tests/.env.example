# Copie para .env e preencha. O .env NÃO vai para o git.
#
# Instância de desenvolvimento na AWS. Para rodar contra um backend local,
# troque para http://localhost:8080 (ou use `pnpm test:local`).
API_BASE_URL=http://98.82.73.175:8080

# Escritório usado pela suíte. Ela CRIA, CANCELA e EXCLUI registros — por isso
# `demo`, e não `tania`. Aceita o slug ou o UUID do tenant.
API_TENANT=demo

# Usuário dedicado ao teste. Não use a conta de uma pessoa: a suíte exclui coisas.
API_LOGIN=
API_PASSWORD=

# Segundo escritório, usado só para provar isolamento entre tenants.
# Sem ele, os testes de vazamento entre escritórios são pulados com aviso.
API_TENANT_SECUNDARIO=tania

# Usuário STAFF do MESMO escritório, para provar que a autorização por papel
# recusa de verdade (STAFF opera, só ADMIN/LAWYER destrói). Sem ele, os testes
# de papel são pulados com aviso — um usuário a mais no banco é decisão do
# escritório, não da suíte.
API_LOGIN_STAFF=
API_PASSWORD_STAFF=

# Runner Postman/Newman. A senha existe apenas no processo/.env e nunca é gravada
# nos snapshots ou relatórios. Tenants diferentes de demo são bloqueados por padrão.
# Override consciente: POSTMAN_ALLOW_NON_DEMO=true npm run postman:all
POSTMAN_ALLOW_NON_DEMO=false
# POSTMAN_REPORT_DIR=./postman/reports
