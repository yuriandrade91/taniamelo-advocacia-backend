{
  "info": {
    "name": "Tania Melo - Agenda (Appointments)",
    "description": "Testes ponta a ponta dos endpoints de Agenda (/api/v1/appointments), com asserts automáticos. Configure as variáveis da coleção (baseUrl, tenant, loginId, password, clientId) e rode pelo Runner ou via newman. O login captura o accessToken; datas passado/futuro são calculadas no pre-request da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Datas determinísticas relativas a agora (ISO-8601 UTC).",
          "const now = Date.now();",
          "const iso = (days, hours) => new Date(now + days*86400000 + hours*3600000).toISOString();",
          "pm.collectionVariables.set('futureStart', iso(2, 0));",
          "pm.collectionVariables.set('futureEnd',   iso(2, 1));",
          "pm.collectionVariables.set('pastStart',   iso(-3, 0));",
          "pm.collectionVariables.set('pastEnd',     iso(-3, 1));",
          "pm.collectionVariables.set('curYear', String(new Date().getUTCFullYear()));",
          "pm.collectionVariables.set('curMonth', String(new Date().getUTCMonth() + 1));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "tenant",
      "value": ""
    },
    {
      "key": "loginId",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": ""
    },
    {
      "key": "futureStart",
      "value": ""
    },
    {
      "key": "futureEnd",
      "value": ""
    },
    {
      "key": "pastStart",
      "value": ""
    },
    {
      "key": "pastEnd",
      "value": ""
    },
    {
      "key": "curYear",
      "value": ""
    },
    {
      "key": "curMonth",
      "value": ""
    },
    {
      "key": "apptId",
      "value": ""
    },
    {
      "key": "pastApptId",
      "value": ""
    },
    {
      "key": "cancelApptId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{loginId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('envelope success', () => pm.expect(b.success).to.be.true);",
                  "pm.test('tem access token', () => pm.expect(b.data.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('accessToken', b.data.token);",
                  "pm.collectionVariables.set('tenantId', b.data.tenantId);",
                  "pm.test('tenantId e slug presentes', () => { pm.expect(b.data.tenantId).to.be.a('string'); pm.expect(b.data.tenantSlug).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. CRUD (happy path)",
      "item": [
        {
          "name": "Criar (futuro, com cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Entrevista com Maria (teste)\",\n  \"type\": \"Entrevista\",\n  \"startAt\": \"{{futureStart}}\",\n  \"endAt\": \"{{futureEnd}}\",\n  \"modality\": \"Presencial\",\n  \"location\": \"Escritório - Sala 1\",\n  \"description\": \"Criado pelo teste automatizado.\",\n  \"clientId\": \"{{clientId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/appointments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('status Agendado', () => pm.expect(b.data.status).to.eql('Agendado'));",
                  "pm.test('clientName veio do cliente', () => pm.expect(b.data.clientName).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('apptId', b.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/appointments/{{apptId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('id confere', () => pm.expect(b.data.id).to.eql(pm.collectionVariables.get('apptId')));"
                ]
              }
            }
          ]
        },
        {
