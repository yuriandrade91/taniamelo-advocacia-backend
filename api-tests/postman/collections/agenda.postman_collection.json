          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('data é array', () => pm.expect(b.data).to.be.an('array'));",
                  "pm.test('tem paginação', () => pm.expect(b.pagination).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resumo por mês (abas)",
