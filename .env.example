# .env.example — modelo do arquivo de ambiente do deploy containerizado.
#
# Copie para `.env` NA RAIZ do repositório, na instância EC2, e preencha.
# O `.env` NÃO é versionado (está no .gitignore) e NÃO é gerado pelo deploy:
# crie-o manualmente uma vez. O scripts/restart-app-docker.sh recusa subir se
# faltar variável, se sobrar placeholder de exemplo, ou se o datasource ainda
# apontar para localhost em vez do serviço "db" do compose.
#
# Gerar segredos fortes (rode e cole o resultado):
#   openssl rand -base64 48   # APP_JWT_SECRET
#   openssl rand -base64 32   # APP_ENCRYPTION_KEY (32 bytes em base64)

# ── Postgres (container "db") ─────────────────────────────────────────────
POSTGRES_DB=lawfirm
POSTGRES_USER=lawfirm
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# ── Datasource da aplicação ───────────────────────────────────────────────
# Dentro do compose o host é "db" (nome do serviço), NUNCA localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/lawfirm
SPRING_DATASOURCE_USERNAME=lawfirm
SPRING_DATASOURCE_PASSWORD=TROQUE_ESTA_SENHA

# ── Perfil ────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Segurança (obrigatórios; gere com os openssl acima) ───────────────────
APP_JWT_SECRET=COLE_AQUI_o_resultado_do_openssl_rand_base64_48
APP_ENCRYPTION_KEY=COLE_AQUI_o_resultado_do_openssl_rand_base64_32

# ── Admin inicial (AdminUserSeeder) ───────────────────────────────────────
APP_ADMIN_EMAIL=admin@taniamelo.adv.br
APP_ADMIN_PASSWORD=TROQUE_ESTA_SENHA

# ── Agente de suporte da plataforma (SupportUserSeeder, control-plane) ────
# Equipe que acessa qualquer escritório via impersonation. Criado no 1º boot
# se public.support_users estiver vazio. Em branco = default de dev (troque!).
APP_SUPPORT_EMAIL=suporte@plataforma.adv.br
APP_SUPPORT_PASSWORD=TROQUE_ESTA_SENHA

# ── Flyway (deixe assim, salvo migração de base legada) ───────────────────
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=0

# ── Armazenamento de arquivos (CNIS/simulações) ───────────────────────────
# "local" usa o volume app-storage do container; "s3" usa o bucket abaixo.
APP_STORAGE_TYPE=local
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=sa-east-1
APP_STORAGE_S3_ENDPOINT=

# ── Credenciais AWS ───────────────────────────────────────────────────────
# Em EC2 com IAM Role, DEIXE VAZIAS: o DefaultCredentialsProvider pega a role
# da instância. Só preencha fora da AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
# "*" só para teste; em produção use o domínio do frontend.
APP_CORS_ALLOWED_ORIGINS=*

# ── Observabilidade (só quando subir docker-compose.observability.yml) ────
# Senha do admin do Grafana (o up falha se ficar vazia). Troque por uma forte.
GRAFANA_ADMIN_PASSWORD=TROQUE_ESTA_SENHA
# Amostragem de tracing quando a stack está no ar (1.0 = 100%). Sem a stack,
# o compose base já mantém em 0 e nada é exportado.
MANAGEMENT_TRACING_SAMPLING=1.0
#
# Subir a stack JUNTO com o app rodando pela IDE (perfil dev). O
# spring-boot-docker-compose usa só o docker-compose.yml (só o Postgres); estas
# linhas fazem ele subir também a observabilidade e raspar o app no host.
# start-only: a stack continua no ar quando o app para (senão Grafana &cia.
# reiniciariam a cada restart do app). START_SKIP=never: sem isto, com o
# Postgres já rodando o Spring pula o "up" inteiro e a stack nunca sobe.
# Ver docs/OBSERVABILIDADE.md.
#SPRING_DOCKER_COMPOSE_FILE=docker-compose.yml,docker-compose.observability.yml
# ...ou, para subir também o SonarQube (pesado: ~2 GiB a mais):
#SPRING_DOCKER_COMPOSE_FILE=docker-compose.yml,docker-compose.observability.yml,docker-compose.sonar.yml
#SPRING_DOCKER_COMPOSE_LIFECYCLE_MANAGEMENT=start-only
#SPRING_DOCKER_COMPOSE_START_SKIP=never
#PROMETHEUS_SCRAPE_CONFIG=prometheus.ide.yml
# ...ou, para os painéis locais mostrarem as métricas do servidor de DEV (EC2)
# em vez do app local (só métricas; traces/logs de lá não chegam aqui):
#PROMETHEUS_SCRAPE_CONFIG=prometheus.dev-server.yml

# ── SonarQube self-hospedado (só quando subir docker-compose.sonar.yml) ───
# Senha do Postgres dedicado do SonarQube (o up falha se ficar vazia).
SONAR_DB_PASSWORD=TROQUE_ESTA_SENHA

# ── Sonar local: tokens e destino da análise ─────────────────────────────
# Token de análise de projeto, um por projeto, gerado na instância local (My Account > Security).
# Preencha só no seu .env (ignorado pelo git); no CI vale o secret SONAR_TOKEN.
SONAR_TOKEN_BACK=
SONAR_TOKEN_FRONT=
SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY_BACK=taniamelo-advocacia-backend
SONAR_PROJECT_KEY_FRONT=taniamelo-advocacia-frontend
