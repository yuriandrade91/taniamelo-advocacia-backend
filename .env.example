# .env.example — modelo do arquivo de ambiente do deploy containerizado.
#
# Copie para `.env` NA RAIZ do repositório, na instância EC2, e preencha.
# O `.env` NÃO é versionado (está no .gitignore) e NÃO é gerado pelo deploy:
# crie-o manualmente uma vez. O scripts/restart-app-docker.sh recusa subir se
# faltar variável, se sobrar placeholder de exemplo, ou se o datasource ainda
# apontar para localhost em vez do serviço "db" do compose.
#
# Gerar segredos fortes (rode e cole o resultado):
#   openssl rand -base64 48   # APP_JWT_SECRET (obrigatório, no mínimo 32 bytes)
#   openssl rand -base64 32   # APP_ENCRYPTION_KEY (32 bytes em base64)
#   openssl rand -base64 32   # APP_FILE_ENCRYPTION_KEY (outra, não reaproveite a de cima)

# ── Postgres (container "db") ─────────────────────────────────────────────
POSTGRES_DB=lawfirm
POSTGRES_USER=lawfirm
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# ── Datasource da aplicação ───────────────────────────────────────────────
# Dentro do compose o host é "db" (nome do serviço), NUNCA localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/lawfirm
SPRING_DATASOURCE_USERNAME=lawfirm
SPRING_DATASOURCE_PASSWORD=TROQUE_ESTA_SENHA

# ── Perfil ────────────────────────────────────────────────────────────────
# Em produção é sempre "postgres". O deploy recusa subir com qualquer outro.
SPRING_PROFILES_ACTIVE=postgres

# ── Domínio público (proxy TLS) ───────────────────────────────────────────
# Nome que o Caddy atende e para o qual emite o certificado (ex.: api.seudominio.adv.br).
# O DNS tem de apontar para a instância antes do primeiro boot. Ver docs/PROXY_TLS.md.
SITE_DOMAIN=api.exemplo.invalid

# ── Segurança (obrigatórios; gere com os openssl acima) ───────────────────
APP_JWT_SECRET=COLE_AQUI_o_resultado_do_openssl_rand_base64_48
APP_ENCRYPTION_KEY=COLE_AQUI_o_resultado_do_openssl_rand_base64_32
# Cifra os documentos e simulações dos clientes no storage. Perder esta chave é
# perder os arquivos: guarde uma cópia fora da instância. A versão vai no cabeçalho
# de cada arquivo e só muda quando a chave for trocada.
APP_FILE_ENCRYPTION_KEY=COLE_AQUI_o_resultado_do_openssl_rand_base64_32
APP_FILE_ENCRYPTION_KEY_VERSION=1

# ── Flyway (deixe assim, salvo migração de base legada) ───────────────────
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=0

# ── Armazenamento de arquivos (CNIS/simulações) ───────────────────────────
# Produção usa "s3" (a aplicação recusa "local" fora de dev/test).
APP_STORAGE_TYPE=s3
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=sa-east-1
APP_STORAGE_S3_ENDPOINT=

# ── Credenciais AWS ───────────────────────────────────────────────────────
# Em EC2 com IAM Role, DEIXE VAZIAS: o DefaultCredentialsProvider pega a role
# da instância. Só preencha fora da AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Cookie do refresh token e validade dos tokens (opcionais) ─────────────
# Atrás de HTTPS, SECURE=true. Com o front em outro domínio que a API, SAMESITE=None.
APP_AUTH_REFRESH_COOKIE_SECURE=true
#APP_AUTH_REFRESH_COOKIE_SAMESITE=Lax
#APP_JWT_EXPIRATION_MINUTES=480
#APP_JWT_REFRESH_EXPIRATION_DAYS=14
# Opções da JVM. Com arquivos de até 60 MB, o heap padrão (25% da RAM) é curto.
#JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70

# ── CORS ──────────────────────────────────────────────────────────────────
# Obrigatório em produção: o domínio do frontend, com https (ex.: https://app.seudominio.adv.br).
# "*" faz a aplicação recusar a subida.
APP_CORS_ALLOWED_ORIGINS=https://app.exemplo.invalid

# ── Observabilidade (só quando subir docker-compose.observability.yml) ────
# Senha do admin do Grafana (o up falha se ficar vazia). Troque por uma forte.
GRAFANA_ADMIN_PASSWORD=TROQUE_ESTA_SENHA
# Amostragem de tracing quando a stack está no ar (1.0 = 100%). Sem a stack,
# o compose base já mantém em 0 e nada é exportado.
MANAGEMENT_TRACING_SAMPLING=1.0
