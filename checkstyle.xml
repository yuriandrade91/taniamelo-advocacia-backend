<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Bug-pattern checks only - no style/formatting rules here (that's Spotless's
  job) and no import-order/star-import restrictions, since several
  controllers and entities use wildcard imports on purpose. Keep this file
  scoped to things that are always a real mistake, not team style
  preferences, so it never fights the existing codebase.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="EqualsAvoidNull"/>
        <module name="StringLiteralEquality"/>
        <module name="EmptyStatement"/>
        <!-- Catch blocks are handled by EmptyCatchBlock below (not here), since it
             already exempts the codebase's "ignored"-named exception convention. -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens"
                      value="LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_TRY, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO"/>
        </module>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="^ignored$"/>
        </module>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="OneStatementPerLine"/>
        <module name="FallThrough"/>
        <module name="ModifiedControlVariable"/>
    </module>
</module>
