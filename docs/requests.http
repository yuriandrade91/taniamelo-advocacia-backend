}

### ── 6. CLIENTE - ENTREVISTA ───────────────────────────────

GET {{host}}/api/v1/clients/{{clientId}}/interviews?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

###
POST {{host}}/api/v1/clients/{{clientId}}/interviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "occurredAt": "2026-07-18T14:00:00Z",
  "durationMinutes": 45,
  "content": "<h3>Entrevista</h3><p>Conteúdo vindo do componente <strong>rich text</strong>.</p>"
}

###
GET {{host}}/api/v1/clients/{{clientId}}/interviews/{{interviewId}}
Authorization: Bearer {{token}}

###
PUT {{host}}/api/v1/clients/{{clientId}}/interviews/{{interviewId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "durationMinutes": 50, "content": "<p>Conteúdo revisado.</p>" }

###
DELETE {{host}}/api/v1/clients/{{clientId}}/interviews/{{interviewId}}
Authorization: Bearer {{token}}

### ── 7. CLIENTE - ARQUIVOS ─────────────────────────────────

### — Documentos (11 tipos) —

GET {{host}}/api/v1/clients/{{clientId}}/files/documents?pageNumber=1&pageSize=10&documentType=Documentos médicos
Authorization: Bearer {{token}}

### Upload em lote (multipart: files[] + metadata[] na mesma ordem)
POST {{host}}/api/v1/clients/{{clientId}}/files/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=BOUNDARY

--BOUNDARY
Content-Disposition: form-data; name="files"; filename="rg.pdf"
Content-Type: application/pdf

< ./exemplo.pdf
--BOUNDARY
Content-Disposition: form-data; name="metadata"
Content-Type: application/json

[{ "documentType": "Documentos de identificação do segurado", "notes": "RG frente e verso" }]
--BOUNDARY--

###
GET {{host}}/api/v1/clients/{{clientId}}/files/documents/{{documentId}}
Authorization: Bearer {{token}}

### Download
GET {{host}}/api/v1/clients/{{clientId}}/files/documents/{{documentId}}/download
Authorization: Bearer {{token}}

### Editar tipo/observações (PATCH)
PATCH {{host}}/api/v1/clients/{{clientId}}/files/documents/{{documentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "documentType": "Documentos cadastrais / dados pessoais", "notes": "Reclassificado" }

###
DELETE {{host}}/api/v1/clients/{{clientId}}/files/documents/{{documentId}}
Authorization: Bearer {{token}}

### — Simulações —

GET {{host}}/api/v1/clients/{{clientId}}/files/simulations?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

### Upload (a mais recente vira principal automaticamente)
POST {{host}}/api/v1/clients/{{clientId}}/files/simulations
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=BOUNDARY

--BOUNDARY
Content-Disposition: form-data; name="files"; filename="simulacao.pdf"
Content-Type: application/pdf

< ./simulacao.pdf
--BOUNDARY
Content-Disposition: form-data; name="metadata"
Content-Type: application/json

[{ "simulationDate": "2026-07-15", "version": "v1.0.2", "vinculos": 4, "notes": "Cenário com período rural" }]
--BOUNDARY--

###
GET {{host}}/api/v1/clients/{{clientId}}/files/simulations/{{simulationId}}
Authorization: Bearer {{token}}

###
GET {{host}}/api/v1/clients/{{clientId}}/files/simulations/{{simulationId}}/download
Authorization: Bearer {{token}}

### Editar metadados
PATCH {{host}}/api/v1/clients/{{clientId}}/files/simulations/{{simulationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "version": "v1.0.3", "vinculos": 5 }

### Trocar a principal
PATCH {{host}}/api/v1/clients/{{clientId}}/files/simulations/{{simulationId}}/principal
Authorization: Bearer {{token}}

###
DELETE {{host}}/api/v1/clients/{{clientId}}/files/simulations/{{simulationId}}
Authorization: Bearer {{token}}

### ── 8. CLIENTE - SITUAÇÃO ─────────────────────────────────

### Histórico de situação (paginado)
GET {{host}}/api/v1/clients/{{clientId}}/situation-history?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

### ── 9. CLIENTE - FINANCEIRO ───────────────────────────────

GET {{host}}/api/v1/clients/{{clientId}}/payments?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

###
POST {{host}}/api/v1/clients/{{clientId}}/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "Honorários - parcela avulsa",
  "amount": 500.00,
  "installmentNumber": 1,
  "installmentTotal": 1,
  "dueDate": "2026-08-10",
  "paymentMethod": "Pix"
}

###
GET {{host}}/api/v1/clients/{{clientId}}/payments/{{paymentId}}
Authorization: Bearer {{token}}

### PATCH parcial (marcar como pago assume paidDate = hoje)
PATCH {{host}}/api/v1/clients/{{clientId}}/payments/{{paymentId2}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "Pago", "paymentMethod": "Pix" }

###
DELETE {{host}}/api/v1/clients/{{clientId}}/payments/{{paymentId2}}
Authorization: Bearer {{token}}
