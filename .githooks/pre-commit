#!/usr/bin/env bash
# Pre-commit gate: auto-format staged Java files, then require lint (Checkstyle)
# and the build (compile) to succeed before the commit is allowed.
#
# `mvn process-classes` runs compile -> spotless:check -> checkstyle:check (see
# pom.xml), so it covers both "lint" and "build" in one call. spotless:apply
# runs first so formatting issues are fixed automatically instead of blocking
# the commit - only a real Checkstyle violation or compile error stops it.
set -e

cd "$(git rev-parse --show-toplevel)"

STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.java')

# Arquivo com parte das mudanças no índice e parte fora (commit parcial, feito
# por `git add -p` ou equivalente). `git add` nele traria TAMBÉM o que ficou de
# fora - ou seja, o commit silenciosamente deixa de ser o que se escolheu
# commitar. Por isso eles são identificados antes e nunca re-adicionados.
PARCIAIS=$(
    comm -12 \
        <(printf '%s\n' "$STAGED_JAVA_FILES" | sort -u) \
        <(git diff --name-only -- '*.java' | sort -u)
)

if [ -n "$STAGED_JAVA_FILES" ]; then
    echo "pre-commit: formatting staged Java files (spotless:apply)..."
    # Spotless formata o disco inteiro (não tem flag por arquivo); guardamos o
    # estado dos parciais para saber se ele mexeu em algum deles.
    ANTES=$(printf '%s\n' "$PARCIAIS" | tr -d '[:space:]')
    if [ -n "$ANTES" ]; then
        HASH_ANTES=$(printf '%s\n' "$PARCIAIS" | xargs md5 -q 2>/dev/null || true)
    fi

    mvn -q spotless:apply

    if [ -n "$ANTES" ]; then
        HASH_DEPOIS=$(printf '%s\n' "$PARCIAIS" | xargs md5 -q 2>/dev/null || true)
        if [ "$HASH_ANTES" != "$HASH_DEPOIS" ]; then
            echo ""
            echo "pre-commit: BLOCKED - estes arquivos estão em commit parcial e"
            echo "precisavam de formatação:"
            printf '  %s\n' $PARCIAIS
            echo "Re-adicione os trechos (o conteúdo no disco já foi formatado)"
            echo "e refaça o commit."
            exit 1
        fi
    fi

    # Re-adiciona só o que está inteiramente no índice. Arquivo em commit
    # parcial fica de fora de propósito: ele já está formatado (verificado
    # acima) e re-adicioná-lo inflaria o commit.
    INTEIROS=$(
        comm -23 \
            <(printf '%s\n' "$STAGED_JAVA_FILES" | sort -u) \
            <(printf '%s\n' "$PARCIAIS" | sort -u)
    )
    if [ -n "$(printf '%s\n' "$INTEIROS" | tr -d '[:space:]')" ]; then
        printf '%s\n' $INTEIROS | xargs git add
    fi
fi

echo "pre-commit: running lint + build (mvn process-classes)..."
if ! mvn -q process-classes; then
    echo ""
    echo "pre-commit: BLOCKED - lint or build failed. Fix the errors above and try again."
    exit 1
fi

echo "pre-commit: lint + build passed."
