#!/usr/bin/env bash
# Pre-commit gate: auto-format staged Java files, then require lint (Checkstyle)
# and the build (compile) to succeed before the commit is allowed.
#
# `mvn process-classes` runs compile -> spotless:check -> checkstyle:check (see
# pom.xml), so it covers both "lint" and "build" in one call. spotless:apply
# runs first so formatting issues are fixed automatically instead of blocking
# the commit - only a real Checkstyle violation or compile error stops it.
set -e

cd "$(git rev-parse --show-toplevel)"

STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.java')

if [ -n "$STAGED_JAVA_FILES" ]; then
    echo "pre-commit: formatting staged Java files (spotless:apply)..."
    mvn -q spotless:apply
    # Re-stage only files that were already part of this commit; unstaged
    # changes in other files are reformatted on disk too (Spotless has no
    # per-file CLI flag) but are deliberately left out of the commit.
    echo "$STAGED_JAVA_FILES" | xargs git add
fi

echo "pre-commit: running lint + build (mvn process-classes)..."
if ! mvn -q process-classes; then
    echo ""
    echo "pre-commit: BLOCKED - lint or build failed. Fix the errors above and try again."
    exit 1
fi

echo "pre-commit: lint + build passed."
