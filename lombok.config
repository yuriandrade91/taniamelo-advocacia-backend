config.stopBubbling = true
# Marca o código gerado com @lombok.Generated: JaCoCo e Sonar o ignoram.
lombok.addLombokGeneratedAnnotation = true
# Só @Getter/@Setter são usados no projeto; @Data/@EqualsAndHashCode/@ToString
# em entidade JPA dão problema com proxies e associações lazy.
lombok.data.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
