<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.lawfirm</groupId>
	<artifactId>law-firm</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>law-firm</name>
	<description>Sistema para escritório de advocacia</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!-- Sobrescrito no deploy com o SHA curto do commit; ver deploy.yml -->
		<git.commit>desconhecido</git.commit>
		<mapstruct.version>1.6.3</mapstruct.version>
		<jjwt.version>0.12.7</jjwt.version>
		<springdoc.version>3.0.3</springdoc.version>
		<awssdk.version>2.31.0</awssdk.version>
		<jacoco.version>0.8.13</jacoco.version>
		<sonar-maven-plugin.version>5.1.0.4751</sonar-maven-plugin.version>

		<!-- SonarQube / SonarCloud: chaveie o projeto e (em CI) passe -Dsonar.token=... .
		     sonar.host.url default aponta para o SonarCloud; troque para a URL do seu
		     SonarQube self-hosted se for o caso. A cobertura vem do JaCoCo (report XML). -->
		<!-- Alinhada com a versão que o spring-boot-testcontainers 4.1.0 já traz do core;
		     o BOM abaixo só estende esse alinhamento aos módulos (postgresql), que o
		     parent do Boot não gerencia. -->
		<testcontainers.version>2.0.5</testcontainers.version>
		<sonar.projectKey>taniamelo-advocacia-backend</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
	</properties>

	<!-- BOM da AWS SDK v2: alinha as versões dos módulos AWS (s3, auth, regions).
	     Só o módulo s3 é usado, e apenas quando app.storage.type=s3 - localmente
	     (type=local) nada da AWS é instanciado. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${awssdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Actuator: required for the docker-compose healthcheck (/actuator/health) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Spring Security + JWT authentication -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- JPA for persistence -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Validation annotations -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>


		<!-- MapStruct -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct-processor</artifactId>
			<version>${mapstruct.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Optional: Lombok to reduce boilerplate (developer choice) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Jackson explicit dependencies to fix test compile issues -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<!-- PostgreSQL driver (runtime) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway for database migrations (Spring Boot 4 moved the autoconfiguration
		     into its own starter; flyway-core alone does not enable it) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Flyway 10+ moved per-database support into separate modules -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Spring Boot DevTools: live reload for development -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Auto-starts docker-compose.yml (the "db" service) when the app boots locally,
		     and stops it on shutdown. Never active when running from the packaged jar/container. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- OpenAPI/Swagger UI generated automatically from the controllers, always in sync -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- AWS S3 (armazenamento de arquivos em nuvem). Ativado só quando
		     app.storage.type=s3; em dev local o bean nem é criado. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testcontainers: os testes de contexto sobem um Postgres real em container.
		     E preciso ser Postgres de verdade, nao um banco em memoria: a aplicacao usa
		     multi-tenancy por schema (search_path), extensao unaccent e Flyway aplicado
		     por schema pelo MultiTenantFlywayMigrator - nada disso e reproduzivel em H2.
		     Versoes gerenciadas pelo BOM do Spring Boot. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.1</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<annotationProcessorPaths>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
					</annotationProcessorPaths>
					<!-- Removed: -Amapstruct.defaultComponentModel=spring -->
					<!-- Using manual bean registration in MapperConfig.java instead -->
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.lawfirm.law.firm.LawFirmApplication</mainClass>
					<!-- Evita o uso da porta JMX padrão (9001) pelo goal 'start' do plugin; define 0 para não tentar conectar -->
					<jmxPort>0</jmxPort>
				</configuration>
				<executions>
					<!-- Gera META-INF/build-info.properties, que o Actuator expõe em
					     /actuator/info. Sem isso não há como saber QUAL versão está
					     rodando numa instância sem entrar por SSH - e sem isso
					     nenhuma comparação "AWS x local" é verificável.

					     `git.commit` vem de fora, via -Dgit.commit no comando do deploy,
					     com "desconhecido" como padrão: assim o build local não
					     precisa de git e o deploy carimba o SHA de verdade. É a opção
					     sem dependência nova - o git-commit-id-maven-plugin faria o
					     mesmo trazendo um plugin a mais para manter. -->
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
						<configuration>
							<additionalProperties>
								<commit>${git.commit}</commit>
							</additionalProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Formatter (the "Prettier" of this project): enforces one canonical
			     Java style via google-java-format (AOSP = 4-space, matching the
			     codebase's existing indentation). Bound to process-classes (right
			     after compile, before test) rather than verify/test, since the
			     pre-commit hook - and CI - must be able to check formatting/lint
			     independently of the test suite's own health. `mvn compile` fails
			     on unformatted code; the pre-commit hook runs `spotless:apply`
			     first so commits never actually hit that failure locally. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.8.0</version>
				<configuration>
					<java>
						<includes>
							<include>src/main/java/**/*.java</include>
							<include>src/test/java/**/*.java</include>
						</includes>
						<googleJavaFormat>
							<version>1.35.0</version>
							<style>AOSP</style>
						</googleJavaFormat>
						<removeUnusedImports/>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>process-classes</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Linter: catches bug-prone patterns and unused code that formatting
			     alone doesn't fix. Deliberately does NOT enforce import style
			     (several controllers/entities use wildcard imports on purpose),
			     so it only flags genuine issues, not the existing codebase's
			     conventions. Bound to process-classes for the same reason as
			     Spotless above - independent of the test phase. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>13.8.0</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<consoleOutput>true</consoleOutput>
					<violationSeverity>warning</violationSeverity>
					<failOnViolation>true</failOnViolation>
					<failsOnError>true</failsOnError>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>process-classes</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- JaCoCo: instrumenta os testes e gera o relatório de cobertura (XML)
			     que o Sonar consome. prepare-agent liga o agente antes dos testes;
			     report gera o XML em target/site/jacoco/jacoco.xml no fim da fase test. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Sonar: análise estática + cobertura. Rode `mvn verify sonar:sonar`
			     (com -Dsonar.token=... em CI). Não roda no build normal nem no
			     pre-commit; é acionado explicitamente. -->
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				<version>${sonar-maven-plugin.version}</version>
			</plugin>
		</plugins>
	</build>

</project>
